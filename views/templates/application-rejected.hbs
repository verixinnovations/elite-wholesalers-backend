<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{candidateName}},</p>
    <p>Thank you for your interest in the <strong>{{jobTitle}}</strong> position at <strong>{{companyName}}</strong>.</p>
    <p>After careful consideration, the hiring team has decided to move forward with other candidates whose qualifications more closely match the current needs of this role.</p>
    <p style="margin: 24px 0 0 0;">We truly appreciate the time and effort you put into your application. Your skills and experience are valuable, and we encourage you to apply for future opportunities that match your profile.</p>
        {{#if notes}}
            <p>{{{notes}}}</p>
        {{/if}}
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{jobBoardLink}}" target="_blank" style="display: inline-block; background: transparent; border: 3px solid #0133fa; border-radius: 36px; color: #0133fa; font-family: Outfit, sans-serif; font-size: 16px; font-weight: 600; padding: 14px 48px; text-decoration: none; width: 100%; box-sizing: border-box; text-align: center;">Explore More Opportunities</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">We wish you the very best in your job search and career journey!</p>
  </td>
</tr>
 
