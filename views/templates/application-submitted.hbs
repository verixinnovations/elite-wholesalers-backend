<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{candidateName}},</p>
    <p>Thank you for applying! Your application for <strong>{{jobTitle}}</strong> at <strong>{{companyName}}</strong> has been successfully submitted.</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Application Summary:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Position:</strong> {{jobTitle}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Company:</strong> {{companyName}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Submitted:</strong> {{submissionDate}}</li>
</ul>
    <p style="margin: 24px 0 0 0;">The hiring team will review your application and get back to you soon. We'll notify you of any updates.</p>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{applicationStatusLink}}" target="_blank" class="button">Track Application Status</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">In the meantime, keep exploring more opportunities on Badge!</p>
  </td>
</tr>
 
