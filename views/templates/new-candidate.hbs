<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{employerName}},</p>
    <p>Excellent news! A qualified candidate has applied for your <strong>{{jobTitle}}</strong> position.</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Candidate Details:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Name:</strong> {{candidateName}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Role:</strong> {{shortBio}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Applied:</strong> {{applicationDate}}</li>
    </ul>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Cover Letter:</strong></p>
    <p style="margin: 0;">{{coverLetter}}</p>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{applicationLink}}" target="_blank" class="button">Review Application</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">Review their full profile, resume, and portfolio in your dashboard.</p>
  </td>
</tr>
 
