<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{candidateName}},</p>
    <p>This is a friendly reminder about your upcoming interview with <strong>{{companyName}}</strong>.</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Interview Details:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Position:</strong> {{jobTitle}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Date:</strong> {{interviewDate}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Time:</strong> {{interviewTime}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Duration:</strong> {{duration}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Format:</strong> {{interviewFormat}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Meeting Link:</strong> {{meetingLink}}</li>
    </ul>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Pre-Interview Checklist:</strong></p>
    <ol style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;">Test your audio/video setup (if virtual)</li>
      <li style="margin: 8px 0; padding-left: 12px;">Review the job description</li>
      <li style="margin: 8px 0; padding-left: 12px;">Research the company</li>
      <li style="margin: 8px 0; padding-left: 12px;">Prepare your questions</li>
      <li style="margin: 8px 0; padding-left: 12px;">Have your resume handy</li>
    </ol>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{interviewLink}}" target="_blank" class="button">Join Interview</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">You've got this! Good luck!</p>
  </td>
</tr>
 
