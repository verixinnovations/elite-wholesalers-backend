<tr>
  <td align='left'>
    <p style='margin-bottom: 12px'>Hi Admin,</p>
    <p>You have received a new inquiry from
      <strong>{{firstname}} {{lastname}}</strong>
      via the Contact Us form on Elite Wholesalers.</p>
  </td>
</tr>
<tr>
  <td>
    <div class='button-wrapper'>
      <a href='mailto:{{email}}' target='_blank' class='button'>Reply to
        Customer</a>
    </div>
  </td>
</tr>
<tr>
  <td align='left'>
    <p style='font-weight: 700; margin: 0 0 24px 0;'>
      <strong>Here are the submission details:</strong>
    </p>
    <ul style='margin: 24px 0; padding-left: 28px;'>
      <li style='margin: 12px 0; padding-left: 12px;'>
        <p style='margin: 0;'>
          <strong style='font-weight: 600;'>Email:</strong>
          {{email}}
        </p>
      </li>
      <li style='margin: 12px 0; padding-left: 12px;'>
        <p style='margin: 0;'>
          <strong style='font-weight: 600;'>Phone:</strong>
          {{phone_number}}
        </p>
      </li>
      <li style='margin: 12px 0; padding-left: 12px;'>
        <p style='margin: 0;'>
          <strong style='font-weight: 600;'>Message:</strong>
          {{message}}
        </p>
      </li>
    </ul>
    <p style='margin: 24px 0 0 0;'>
      Please review and follow up with the customer promptly.
    </p>
  </td>
</tr>