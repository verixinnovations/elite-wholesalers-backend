<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{candidateName}},</p>
    <p>Your application for <strong>{{jobTitle}}</strong> at <strong>{{companyName}}</strong> has been withdrawn as requested.</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Withdrawal Details:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Job:</strong> {{jobTitle}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Company:</strong> {{companyName}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Applied:</strong> {{applicationDate}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Withdrawn:</strong> {{withdrawalDate}}</li>
    </ul>
    <p style="margin: 24px 0 0 0;">The employer has been notified and your application has been removed from their review queue.</p>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{jobSearchLink}}" target="_blank" class="button">Find Other Opportunities</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">Keep exploring - your perfect role is out there!</p>
  </td>
</tr>
 
