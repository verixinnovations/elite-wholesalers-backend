<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{employerName}},</p>
    <p>Your listing for <strong>{{jobTitle}}</strong> has been successfully removed from Elite Wholesalers.</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Posting Summary:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Job ID:</strong> {{jobId}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Posted:</strong> {{postDate}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Closed:</strong> {{closeDate}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Total Applications:</strong> {{totalApplications}}</li>
    </ul>
    <p style="margin: 24px 0 0 0;">All associated applications have been archived for the next <strong>90 days</strong>.</p>
    <p style="margin: 12px 0 0 0;">We hope you found the perfect candidate! If you're hiring again, we're here to help or you want to retrieve the job kindly contact us before next 90 days.</p>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{postNewJobLink}}" target="_blank" class="button">Post Another Job</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
