<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{title}}</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Audiowide&display=swap" rel="stylesheet">
  
  <style>
    /* Animations */
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-15px); }
    }

    /* Base Styles */
    body {
      margin: 0 !important;
      padding: 0 !important;
      background-color: #f5f7fa;
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      color: #2d3748;
      line-height: 1.6;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
    
    table {
      border-spacing: 0;
      border-collapse: collapse;
    }

    td {
      vertical-align: top;
    }
    
    img {
      border: 0;
      outline: none;
      display: block;
      max-width: 100%;
      height: auto;
    }

    a {
      color: #3301fa;
      text-decoration: none;
    }

    h1, h2, h3, h4, h5, h6 {
      margin: 0;
      padding: 0;
      line-height: 1.2;
    }

    p {
      margin: 0;
      padding: 0;
    }

    /* Header */
    .header-gradient {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #f093fb 50%, #4facfe 75%, #00f2fe 100%);
      background-size: 400% 400%;
      animation: gradientShift 8s ease infinite;
    }

    .header-badge img {
      max-width: 90px;
      filter: brightness(0) invert(1) drop-shadow(0 4px 15px rgba(0, 0, 0, 0.2));
      margin: 0 auto;
    }

    .header-title h1 {
      font-size: 40px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -1px;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    /* Content Styles */
    .body-text {
      font-size: 16px;
      line-height: 1.8;
      color: #4a5568;
    }

    

    .body-text p {
      margin: 0 0 16px 0;
      font-size: 16px;
      line-height: 1.8;
    }

    .body-text p:last-child {
      margin-bottom: 0;
    }

    strong {
      font-weight: 700 !important;
      color: #0150fa !important;
    }

    .body-text ul {
      margin: 16px 0;
      padding-left: 28px;
      list-style: circle;
    }

    .body-text ul li {
      margin: 8px 0;
      font-size: 16px;
      line-height: 1.8;
      color: #4a5568;
    }

    .body-text ol {
      margin: 16px 0;
      padding-left: 28px;
    }

    .body-text ol li {
      margin: 8px 0;
      font-size: 16px;
      line-height: 1.8;
      color: #4a5568;
    }

    /* Button */
    .button-wrapper{
        max-width: 320px !important;
        margin: 20px auto;
    }

    .button {
      display: block;
      text-align: center;
      background: transparent !important;
      border: 3px solid #0133fa !important;
      border-radius: 36px;
      color: #0133fa !important;
      font-size: 16px;
      font-weight: 600 !important;
      padding: 14px 48px;
      text-decoration: none !important;
      transition: all 0.3s ease;
      width: 100%;
      box-sizing: border-box;
      line-height: 1.5;
    }

    .button:hover {
      background: #3301fa !important;
      color: #ffffff !important;
      box-shadow: 0 8px 20px rgba(51, 1, 250, 0.3);
    }

    /* Cheers Section */
    .cheers-text {
      font-size: 24px;
      font-weight: 800 !important;
      font-family: 'Audiowide', sans-serif !important;
      background: linear-gradient(120deg, #667eea, #764ba2);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin: 0 0 6px 0;
    }

    .team-text {
      font-size: 20px;
      font-weight: 700;
      color: #2d3748;
      margin: 0;
    }

    /* Footer */
    .footer-bg {
      background-color: #f8f9fb;
    }

    .social-heading {
      font-size: 18px;
      font-weight: 700;
      color: #2d3748;
      margin: 0 0 18px 0;
      text-align: center;
    }

    .social-icon {
      width: 50px;
      height: 50px;
      text-align: center;
      line-height: 50px;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .social-icon:hover {
      background: #3301fa;
      transform: translateY(-4px) scale(1.1);
    }

    .social-icon:hover img {
      filter: brightness(0) invert(1);
    }

    .social-icon img {
       display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      width: 24px;
      height: 24px;
      vertical-align: middle;
      transition: all 0.3s ease;
    }

    .legal-notice {
      font-size: 12px;
      line-height: 1.6;
      color: #a0aec0;
      margin: 6px 0;
      text-align: center;
    }

    /* Mobile Responsiveness */
    @media screen and (max-width: 600px) {
      .header-padding {
        padding: 40px 25px !important;
      }
      .header-badge img {
        max-width: 70px;
      }
      .header-title h1 {
        font-size: 24px !important;
        letter-spacing: -0.5px;
      }
      .content-padding {
        padding: 30px 25px !important;
      }
      .body-text p {
        font-size: 12px !important;
      }

      p{
        font-size: 12px !important;
      }
      li {
        font-size: 12px !important;
      }

      .body-text ul li,
      .body-text ol li {
        font-size: 12px !important;
      }
      .button {
        width: 100% !important;
        max-width: 320px;
        padding: 12px 20px !important;
        font-size: 15px !important;
      }
      .cheers-divider-padding {
        padding: 16px 0 !important;
      }
      .cheers-text {
        font-size: 16px !important;
      }
      .team-text {
        font-size: 14px !important;
      }
      .footer-padding {
        padding: 28px 25px !important;
      }
      .social-heading {
        font-size: 16px !important;
      }
      .legal-notice {
        font-size: 8px !important;
      }
    }
  </style>
</head>

<body>
    <table class="container" width="640" align="center" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="max-width: 640px; border-radius: 24px; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);">
      
      <tr>
        <td class="header-gradient header-padding" align="center" style="padding: 50px 40px;">
          <table width="100%" border="0" cellpadding="0" cellspacing="0">
            <tr>
              <td align="center" class="header-title">
                <h1 class="">{{pageHeading}}</h1>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td class="content-padding" style="padding: 40px 45px;">
          <table width="100%" border="0" cellpadding="0" cellspacing="0">
            <tr>
              <td class="body-text">
                {{{body}}}
              </td>
            </tr>
            <tr>
              <td style="height: 30px; line-height: 30px; font-size: 1px;">&nbsp;</td>
            </tr>
            <tr>
              <td class="cheers-divider-padding" style="padding: 20px 0; border-top: 2px solid #e2e8f0;">
                <p class="cheers-text">Cheers!</p>
                <p class="team-text">The Badge Team.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td class="footer-bg footer-padding" style="padding: 35px 45px; background-color: #f8f9fb; border-top: 1px solid #e2e8f0;">
          <table width="100%" border="0" cellpadding="0" cellspacing="0">
            <tr>
              <td>
                <p class="social-heading">Tell your friends</p>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 0 0 25px 0;">
                <table border="0" cellpadding="0" cellspacing="0" style="display: inline-block;">
                  <tr>
                    <td style="padding: 0 4px;"><a href="https://facebook.com" class="social-icon"><img src="https://fznqofm.stripocdn.email/content/assets/img/social-icons/logo-black/facebook-logo-black.png" width="24" height="24" style="display:block"></a></td>
                    <td style="padding: 0 4px;"><a href="https://twitter.com" class="social-icon"><img src="https://fznqofm.stripocdn.email/content/assets/img/social-icons/logo-black/x-logo-black.png" width="24" height="24" style="display:block"></a></td>
                    <td style="padding: 0 4px;"><a href="https://instagram.com" class="social-icon"><img src="https://fznqofm.stripocdn.email/content/assets/img/social-icons/logo-black/instagram-logo-black.png" width="24" height="24" style="display:block"></a></td>
                    <td style="padding: 0 4px;"><a href="https://youtube.com" class="social-icon"><img src="https://fznqofm.stripocdn.email/content/assets/img/social-icons/logo-black/youtube-logo-black.png" width="24" height="24" style="display:block"></a></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent); padding: 20px 0;">&nbsp;</td>
            </tr>
            <tr>
              <td>
                <p class="legal-notice">You're receiving this email because you registered on Badge and agreed to our Terms and Conditions.</p>
                <p class="legal-notice">If you didn't create an account, please ignore this message.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td align="center" style="padding: 30px 20px; background-color: #ffffff;">
          <a target="_blank" href="https://connectwithbadge.com">
            <img src="https://fznqofm.stripocdn.email/content/guids/CABINET_97df5f48e12908e29570ac3bc98b76dd1f0a5d008053d3f9f5c85f7b2be17b61/images/logo.png" width="125" style="display: block; margin: 0 auto;">
          </a>
        </td>
      </tr>

    </table>
</body>
</html>