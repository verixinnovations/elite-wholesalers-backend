<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{employerName}},</p>
    <p>Just a heads up - your job posting for <strong>{{jobTitle}}</strong> will expire in <strong>{{daysRemaining}} days</strong>.</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Current Stats:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Applications:</strong> {{applicationCount}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Views:</strong> {{viewCount}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Expiry Date:</strong> {{expiryDate}}</li>
    </ul>
    <p style="margin: 24px 0 0 0;">Want to keep your posting active and continue receiving applications?</p>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{renewLink}}" target="_blank" class="button">Renew Job Posting</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">If you've already filled the position, you can close the posting anytime from your dashboard.</p>
  </td>
</tr>
 
