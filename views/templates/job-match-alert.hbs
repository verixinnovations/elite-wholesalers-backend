<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{candidateName}},</p>
    <p>We found <strong>{{matchCount}} new job(s)</strong> that match your profile and preferences!</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Top Matches:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;"><strong>{{job1Title}}</strong> at {{company1}} - {{location1}} ({{matchScore1}}% match)</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>{{job2Title}}</strong> at {{company2}} - {{location2}} ({{matchScore2}}% match)</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>{{job3Title}}</strong> at {{company3}} - {{location3}} ({{matchScore3}}% match)</li>
    </ul>
    <p style="font-weight: 700; margin: 24px 0 12px 0;">These opportunities align with your:</p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;">Skills and experience</li>
      <li style="margin: 8px 0; padding-left: 12px;">Location preferences</li>
      <li style="margin: 8px 0; padding-left: 12px;">Salary expectations</li>
      <li style="margin: 8px 0; padding-left: 12px;">Career goals</li>
    </ul>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{matchesLink}}" target="_blank" class="button">View Matched Jobs</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">Don't miss out on these opportunities - top positions get filled quickly!</p>
  </td>
</tr>
 
