<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{employerName}},</p>
    <p>Great news! Your job posting has been successfully published on Badge.</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Job Details:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Position:</strong> {{jobTitle}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Location:</strong> {{jobLocation}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Posted:</strong> {{postDate}}</li>
      <li style="margin: 8px 0; padding-left: 12px;"><strong>Job ID:</strong> {{jobId}}</li>
    </ul>
    <p style="margin: 24px 0 0 0;">Your job is now live and candidates can start applying. We'll notify you as soon as applications come in!</p>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{jobLink}}" target="_blank" class="button">View Job Posting</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">You can manage applications and edit your posting anytime from your dashboard.</p>
  </td>
</tr>
 
