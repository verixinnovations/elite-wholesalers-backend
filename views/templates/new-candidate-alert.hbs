<tr>
  <td align="left">
    <p style="margin-bottom: 12px">Hi {{employerName}},</p>
    <p>You have <strong>{{newApplicationsCount}} new application(s)</strong> for your job posting!</p>
    <p style="font-weight: 700; margin: 12px 0;"><strong>Position:</strong> {{jobTitle}}</p>
    <p style="font-weight: 700; margin: 24px 0 12px 0;"><strong>Recent Applicants:</strong></p>
    <ul style="margin: 12px 0; padding-left: 28px;">
      <li style="margin: 8px 0; padding-left: 12px;">{{candidate1}} - Applied {{time1}}</li>
      <li style="margin: 8px 0; padding-left: 12px;">{{candidate2}} - Applied {{time2}}</li>
      <li style="margin: 8px 0; padding-left: 12px;">{{candidate3}} - Applied {{time3}}</li>
    </ul>
  </td>
</tr>
<tr>
  <td align="center" style="padding: 30px 0;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 320px; margin: 0 auto;">
      <tr>
        <td align="center">
          <a href="{{dashboardLink}}" target="_blank" class="button">View All Applications</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td align="left">
    <p style="margin: 24px 0 0 0;">Don't keep great talent waiting - review and respond to applications quickly to secure the best candidates.</p>
  </td>
</tr>
 
